+// Keep both the address walk and the search for other reads local. In
+// particular, do not extend an address live range across a large basic block.
+static constexpr unsigned DSReadSearchLimit = 64;
+
+// The read2 builder preserves the descriptor's implicit EXEC use. Do not lose
+// additional scheduling dependencies or physical-register definitions, nor
+// assume an address add with such operands will become dead after recovery.
+static bool hasOnlyExecImplicitUse(const MachineInstr &MI) {
+  for (const MachineOperand &Op : MI.implicit_operands()) {
+    if (!Op.isReg() || Op.isDef() || Op.getReg() != AMDGPU::EXEC || Op.isUndef())
+      return false;
+  }
+  return true;
+}
+
+std::optional<SILoadStoreOptimizer::DSReadAddress>
+SILoadStoreOptimizer::getDSReadAddress(MachineInstr &MI) const {
+  if (getInstClass(MI.getOpcode(), *TII) != DS_READ || MI.isBundled() ||
+      MI.hasOrderedMemoryRef() || MI.hasUnmodeledSideEffects() ||
+      MI.memoperands_empty() || !hasOnlyExecImplicitUse(MI))
+    return std::nullopt;
+  if (TII->getNamedOperand(MI, AMDGPU::OpName::gds)->getImm())
+    return std::nullopt;
+  for (const MachineMemOperand *MMO : MI.memoperands()) {
+    if (MMO->isAtomic() || MMO->getAddrSpace() != AMDGPUAS::LOCAL_ADDRESS)
+      return std::nullopt;
+  }
+
+  const MachineOperand *Addr = TII->getNamedOperand(MI, AMDGPU::OpName::addr);
+  auto IsFullVReg = [&](const MachineOperand &Op) {
+    return Op.isReg() && Op.getReg().isVirtual() && !Op.getSubReg() &&
+           !Op.isUndef() && TRI->getRegSizeInBits(Op.getReg(), *MRI) == 32;
+  };
+  if (!IsFullVReg(*Addr))
+    return std::nullopt;
+
+  auto GetConstant = [&](const MachineOperand &Op) -> std::optional<int32_t> {
+    if (!Op.isImm() && !IsFullVReg(Op))
+      return std::nullopt;
+    return extractConstOffset(Op);
+  };
+
+  Register Base = Addr->getReg();
+  MachineInstr *Use = &MI;
+  // DS offsets are unsigned, even when MIR prints the immediate as negative.
+  uint32_t Offset =
+      TII->getNamedOperand(MI, AMDGPU::OpName::offset)->getImm() & 0xffff;
+  for (unsigned Depth = 0; Depth != 4; ++Depth) {
+    MachineInstr *Def = MRI->getUniqueVRegDef(Addr->getReg());
+    if (!Def || Def->getOpcode() != AMDGPU::V_ADD_U32_e64 ||
+        Def->getParent() != MI.getParent() || Def->isBundled() ||
+        Def->getOperand(0).getSubReg() || !hasOnlyExecImplicitUse(*Def) ||
+        TII->getNamedOperand(*Def, AMDGPU::OpName::clamp)->getImm())
+      break;
+
+    // A vector add only computes active lanes. Peeling an add across a change
+    // to EXEC could use a value that was not computed for the load's lanes.
+    auto I = Use->getIterator();
+    unsigned Remaining = DSReadSearchLimit;
+    while (I != Def->getIterator() && Remaining) {
+      --I;
+      if (I->modifiesRegister(AMDGPU::EXEC, TRI) || I->isBundled() ||
+          I->isCall() || I->isTerminator() || I->hasUnmodeledSideEffects())
+        return std::nullopt;
+      if (!I->isDebugInstr())
+        --Remaining;
+    }
+    if (I != Def->getIterator())
+      break;
+
+    const MachineOperand *S0 = TII->getNamedOperand(*Def, AMDGPU::OpName::src0);
+    const MachineOperand *S1 = TII->getNamedOperand(*Def, AMDGPU::OpName::src1);
+    auto C = GetConstant(*S0);
+    if (C)
+      std::swap(S0, S1);
+    else
+      C = GetConstant(*S1);
+    if (!C || !IsFullVReg(*S0))
+      break;
+
+    // V_ADD_U32 and LDS address arithmetic are modulo 2^32. Do not use signed
+    // addition here: a constant chain can wrap around the 32-bit address space.
+    Offset += static_cast<uint32_t>(*C);
+    Addr = S0;
+    Use = Def;
+  }
+
+  if (!TRI->isVGPRClass(MRI->getRegClass(Addr->getReg())))
+    return std::nullopt;
+  return DSReadAddress{&MI, Base, Addr->getReg(), SignExtend64<32>(Offset)};
+}
+
+bool SILoadStoreOptimizer::recoverDSReadBase(MachineInstr &MI) {
+  if (!MRI->isSSA() || !STM->hasUsableDSOffset() || !STM->hasAddNoCarry() ||
+      getInstClass(MI.getOpcode(), *TII) != DS_READ /* Temporary DS_READ Only */)
+    return false;
+
+  auto *Addr = TII->getNamedOperand(MI, AMDGPU::OpName::addr);
+  if (!Addr->isReg() || !Addr->getReg().isVirtual())
+    return false;
+  // Preserve already-shared DS groups, including ones whose large offsets
+  // the existing merger can rebase. A base used by an add, rather than another
+  // DS read, can still need recovery across a 64 KiB immediate boundary.
+  if (!MRI->hasOneNonDBGUse(Addr->getReg())) {
+    if ((TII->getNamedOperand(MI, AMDGPU::OpName::offset)->getImm() & 0xffff) < 1024)
+      return false;
+    unsigned Remaining = DSReadSearchLimit;
+    for (MachineInstr &Use : MRI->use_nodbg_instructions(Addr->getReg())) {
+      if (!Remaining)
+        return false;
+      --Remaining;
+      if (&Use != &MI && getInstClass(Use.getOpcode(), *TII) == DS_READ)
+        return false;
+    }
+  }
+
+  auto First = getDSReadAddress(MI);
+  if (!First)
+    return false;
+
+  SmallVector<DSReadAddress, 16> Candidates;
+  int64_t Min = First->Offset, Max = Min;
+  unsigned Remaining = DSReadSearchLimit;
+  for (MachineBasicBlock::iterator I = std::next(MI.getIterator()),
+                                   E = MI.getParent()->end(); I != E && Remaining; ++I) {
+    if (I->isDebugInstr())
+      continue;
+    --Remaining;
+    if (I->isBundled() || I->isTerminator() || I->isCall() || I->mayStore() ||
+        I->hasOrderedMemoryRef() || I->hasUnmodeledSideEffects() ||
+        I->modifiesRegister(AMDGPU::EXEC, TRI))
+      break;
+    if (I->getOpcode() != MI.getOpcode())
+      continue;
+    auto A = getDSReadAddress(*I);
+    // Leave other already-shared bases to the existing merger. Replacing a
+    // single-use address also makes its final add dead, paying for a new base
+    // if the first address cannot be reused.
+    if (!A || A->Root != First->Root || A->Base == First->Base ||
+        A->Base == A->Root || !MRI->hasOneNonDBGUse(A->Base))
+      continue;
+    int64_t NewMin = std::min(Min, A->Offset);
+    int64_t NewMax = std::max(Max, A->Offset);
+    if (!isUInt<16>(NewMax - NewMin))
+      continue;
+    Min = NewMin;
+    Max = NewMax;
+    Candidates.push_back(*A);
+  }
+
+  SmallVector<DSReadAddress, 16> Reads;
+  for (const DSReadAddress &A : Candidates) {
+    CombineInfo CI, Paired;
+    CI.setMI(MI, *this);
+    Paired.setMI(*A.MI, *this);
+    if (CI.DataRC != Paired.DataRC)
+      continue;
+    CI.Offset = First->Offset - Min;
+    Paired.Offset = A.Offset - Min;
+
+    // Test the exact existing merge checks with the prospective shared base.
+    // This also checks register dependencies after removing the dependence on
+    // the second address computation. Do not commit a rewrite on failure.
+    auto *OtherAddr = TII->getNamedOperand(*A.MI, AMDGPU::OpName::addr);
+    bool WasKill = OtherAddr->isKill();
+    OtherAddr->setReg(First->Base);
+    OtherAddr->setIsKill(false);
+    CombineInfo *Where = checkAndPrepareMerge(CI, Paired);
+    OtherAddr->setReg(A.Base);
+    OtherAddr->setIsKill(WasKill);
+    // Avoid a normalization that itself needs another base adjustment to form
+    // read2. The usual merger remains responsible for encoding and movement.
+    if (Where && CI.BaseOff == 0)
+      Reads.push_back(A);
+  }
+  if (Reads.empty())
+    return false;
+
+  Register Common = First->Base;
+  if (Min != First->Offset || TII->getNamedOperand(MI, AMDGPU::OpName::offset)->getImm() != 0) {
+    Common = MRI->createVirtualRegister(&AMDGPU::VGPR_32RegClass);
+    MachineOperand Constant = createRegOrImm(static_cast<int32_t>(Min), MI);
+    MRI->clearKillFlags(First->Root);
+    TII->getAddNoCarry(*MI.getParent(), MI, MI.getDebugLoc(), Common)
+        .addReg(First->Root)
+        .add(Constant)
+        .addImm(0);
+  }
+
+  Reads.push_back(*First);
+  for (const DSReadAddress &A : Reads) {
+    TII->getNamedOperand(*A.MI, AMDGPU::OpName::addr)->setReg(Common);
+    TII->getNamedOperand(*A.MI, AMDGPU::OpName::offset)->setImm(A.Offset - Min);
+  }
+  MRI->clearKillFlags(Common);
+  LLVM_DEBUG(dbgs() << "Recovered DS read base: " << MI);
+  return true;
+}
