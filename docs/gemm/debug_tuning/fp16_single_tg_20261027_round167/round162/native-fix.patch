+        Value pointer = b.gep(ptr_ty(ctx, 1), i16_ty, llBasePtr, offset);
+        Value stride = b.trunc(i32_ty, llStrides[blockLayout.getOrder()[1]]);
+        Value descriptor = loadHelper.createRsrcDesc(
+            loc, rewriter, mlsInsn->getMlsVersion(), pointer, stride,
+            blockLayout.getAlt2Kind(), b.i32_val(0), b.i32_val(0));
+        stores.emplace_back(packed, descriptor);
+      }
+      for (auto [packed, descriptor] : stores)
+        generateMatrixStoreVGPROp(loc, rewriter, msInsnAttr.insn, packed,
+                                 descriptor, mlsInsn->isRowMajor(), 0, false,
+                                 8, false, false);
+      rewriter.eraseOp(opToErase);
+      return success();
+    }
