+      for (auto &entry : tileValues) {
+        SmallVector<Value> packedValues;
+        for (unsigned group = 0; group < 16; group += 8)
+          for (unsigned element = 0; element < 4; ++element)
+            for (unsigned part = 0; part < 2; ++part)
+              packedValues.push_back(entry.second[group + part * 4 + element]);
+        Value packed = packMatrixStoreVGPRArgs(
+            loc, rewriter, valueTy, msInsnAttr, packedValues);
+        Value row = b.add(llOffsets[0], b.xor_(warpM, b.i32_val(entry.first.first)));
+        Value col = b.add(llOffsets[1], b.xor_(warpN, b.i32_val(entry.first.second)));
