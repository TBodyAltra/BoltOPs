+ for role,part in [(1,source[markers[1].start():markers[2].start()]),(2,source[markers[2].start():])]:
+  defs={}
+  for l in part.splitlines():
+   m=re.match(r'\s*('+SSA+r') = (.*)',l)
+   if m:defs[m[1]]=m[2]
+  seen={0:0,1:0}
