+  rl=result.splitlines();fwait=next(i for i,l in enumerate(rl) if lines[waits[ready]].strip()==l.strip());swait=next(i for i,l in enumerate(rl) if lines[waits[mapping['AB'[second]]['ready']]].strip()==l.strip());release=next(i for i,l in enumerate(rl) if lines[releases[empty]].strip()==l.strip());rfirst=[i for i,l in enumerate(rl) if any(l.strip()==lines[j].strip() for j in reads[first])];rsecond=[i for i,l in enumerate(rl) if any(l.strip()==lines[j].strip() for j in reads[second])]
