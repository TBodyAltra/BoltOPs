diff --git a/third_party/hcu/lib/TritonHCUTransforms/AccelerateHCUMatmul.cpp b/third_party/hcu/lib/TritonHCUTransforms/AccelerateHCUMatmul.cpp
index b9a9de370..c6e8cc95d 100644
--- a/third_party/hcu/lib/TritonHCUTransforms/AccelerateHCUMatmul.cpp
+++ b/third_party/hcu/lib/TritonHCUTransforms/AccelerateHCUMatmul.cpp
@@ -104,6 +104,42 @@ DotOperandMatrixLoadInfo getDotOperandMatrixLoadInfo(DotOpInterface dotOp,
     if (opIdx >= 0 && opIdx < 2 && !matrixOps[opIdx])
       matrixOps[opIdx] = mOp;
   });
+  // Experimental: split K fragments retain the MLS source of both halves.
+  // The normal forward search associates a matrix load with only the first
+  // dot; subsequent fragments otherwise get an incompatible fallback layout.
+  if (auto enabled = mod->getAttrOfType<BoolAttr>("hcu.fragment_mls_layout");
+      enabled && enabled.getValue()) {
+    if (auto plainDot = dyn_cast<tt::DotOp>(dotOp.getOperation())) {
+      for (int idx = 0; idx < 2; ++idx) {
+        if (matrixOps[idx])
+          continue;
+        Value value = idx == 0 ? plainDot.getA() : plainDot.getB();
+        auto operandTy = cast<RankedTensorType>(value.getType());
+        unsigned splitCount = 0;
+        for (unsigned depth = 0; depth < 16 && value; ++depth) {
+          Operation *def = value.getDefiningOp();
+          if (!def)
+            break;
+          if (auto load = dyn_cast<tt::MatrixLoadOp>(def)) {
+            auto sourceTy = load.getType();
+            unsigned kAxis = 1 - idx;
+            if (splitCount >= 1 && splitCount <= 2 && operandTy.getRank() == 2 &&
+                sourceTy.getRank() == 2 && operandTy.getElementType().isF16() &&
+                sourceTy.getElementType() == operandTy.getElementType() &&
+                sourceTy.getShape()[idx] == operandTy.getShape()[idx] &&
+                sourceTy.getShape()[kAxis] == (1LL << splitCount) * operandTy.getShape()[kAxis])
+              matrixOps[idx] = load;
+            break;
+          }
+          if (isa<tt::SplitOp>(def))
+            ++splitCount;
+          else if (!isa<tt::ReshapeOp, tt::TransOp, ttg::ConvertLayoutOp>(def))
+            break;
+          value = def->getOperand(0);
+        }
+      }
+    }
+  }
   std::array<std::optional<MatrixLoadInfo>, 2> infos = {
       buildDotOperandMatrixLoadInfo(dotOp, 0, matrixOps[0]),
       buildDotOperandMatrixLoadInfo(dotOp, 1, matrixOps[1])};
