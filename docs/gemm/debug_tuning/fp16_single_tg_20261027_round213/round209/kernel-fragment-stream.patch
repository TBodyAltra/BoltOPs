+    m0, n0, k0,
+    BM: tl.constexpr, BN: tl.constexpr, KF: tl.constexpr,
+    B_FIRST: tl.constexpr,
+):
+    if B_FIRST:
+        b = tl.matrix_load(b_ptr, shape=[K, N], strides=[stride_bk, stride_bn],
+                           block_shape=[KF, BN], offsets=[k0, n0])
+        a = tl.matrix_load(a_ptr, shape=[M, K], strides=[stride_am, stride_ak],
+                           block_shape=[BM, KF], offsets=[m0, k0])
+    else:
+        a = tl.matrix_load(a_ptr, shape=[M, K], strides=[stride_am, stride_ak],
+                           block_shape=[BM, KF], offsets=[m0, k0])
+        b = tl.matrix_load(b_ptr, shape=[K, N], strides=[stride_bk, stride_bn],
+                           block_shape=[KF, BN], offsets=[k0, n0])
+    return a, b
+
