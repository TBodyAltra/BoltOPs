# Raw per-round PMD output (case/worker logs, asm, caches, perf, stats) stays out of Git for every version
# (generic/ and specialized_*/); keep each run's summary.json.
[GR]*/*/runs/*/round_*/
# Local-only IR / assembly / perf captures (repro_generic/capture.sh)
[GR]*/*/runs/*_ir_asm_perf/
__pycache__/
*.pyc
