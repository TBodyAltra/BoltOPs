+    def perf(self, op_instance):
+        # PMD diagnostic: one tensor set, zero warmups, one measured call.
+        # Operator implementation and its precision parser are unchanged.
+        from pathlib import Path
+        from torch.utils._python_dispatch import TorchDispatchMode
+        def describe(t):
+            if isinstance(t, torch.Tensor):
+                return dict(shape=list(t.shape), dtype=str(t.dtype), device=str(t.device))
+            if isinstance(t, (list, tuple)):
+                return [describe(x) for x in t]
+            return str(t)
+        class Trace(TorchDispatchMode):
+            def __torch_dispatch__(self, func, types, args=(), kwargs=None):
+                print('PMD_OP_BEGIN', str(func), json.dumps(describe(args)), flush=True)
+                out=func(*args, **(kwargs or {}))
+                print('PMD_OP_END', str(func), json.dumps(describe(out)), flush=True)
+                return out
+        metadata=dict(inputs={k:dict(shape=v.shape,dtype=str(v.dtype)) for k,v in op_instance.input_tensor_info.items()},outputs={k:dict(shape=v.shape,dtype=str(v.dtype)) for k,v in op_instance.output_tensor_info.items()})
+        Path('int8-contract.json').write_text(json.dumps(metadata,indent=2))
+        print('PMD_CREATE_TENSORS_BEGIN',flush=True)
+        tensors=op_instance.create_tensors(1)
+        print('PMD_CREATE_TENSORS_END',flush=True)
+        with Trace():
+            latency_us,kernels=self.core_perf(op_instance,0,1,tensors,profiling=False)
+        print('PMD_REFERENCE_CALL_COMPLETED',latency_us,flush=True)
+        return op_instance.summary(latency_us,kernels)
 
 
